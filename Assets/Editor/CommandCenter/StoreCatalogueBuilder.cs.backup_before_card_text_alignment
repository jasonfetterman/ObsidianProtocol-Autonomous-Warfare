    [MenuItem("Obsidian Protocol/Command Center/BUILD AAA UNIT STORE")]
    public static void Build()
    {
        var scene = SceneManager.GetActiveScene();
        if (scene.path != ScenePath)
            scene = EditorSceneManager.OpenScene(ScenePath);

        string backup = ScenePath + ".backup_before_AAA_store";
        if (!System.IO.File.Exists(backup))
            System.IO.File.Copy(ScenePath, backup);

        GameObject store = FindSceneObject("STORE_REAL_PANEL");
        if (store == null)
        {
            Debug.LogError("[STORE] STORE_REAL_PANEL not found.");
            return;
        }

        for (int i = store.transform.childCount - 1; i >= 0; i--)
            UnityEngine.Object.DestroyImmediate(store.transform.GetChild(i).gameObject);

        RectTransform storeRect = store.GetComponent<RectTransform>();
        if (storeRect == null)
        {
            Debug.LogError("[STORE] Panel has no RectTransform.");
            return;
        }

        GameObject root = new GameObject("AAA_UNIT_STORE", typeof(RectTransform), typeof(Image));
        root.transform.SetParent(store.transform, false);
        Stretch(root.GetComponent<RectTransform>());
        root.GetComponent<Image>().color = Background;

        BuildHeader(root.transform);
        StoreCatalogueInteractionController controller = root.AddComponent<StoreCatalogueInteractionController>();
        BuildDetailsPanel(root.transform, controller);

        GameObject scrollRoot = new GameObject("CATALOGUE_SCROLL", typeof(RectTransform), typeof(ScrollRect));
        scrollRoot.transform.SetParent(root.transform, false);

        RectTransform scrollRect = scrollRoot.GetComponent<RectTransform>();
        scrollRect.anchorMin = Vector2.zero;
        scrollRect.anchorMax = Vector2.one;
        scrollRect.offsetMin = new Vector2(0, 0);
        scrollRect.offsetMax = new Vector2(0, -112);

        GameObject viewport = new GameObject("VIEWPORT", typeof(RectTransform), typeof(Image), typeof(Mask));
        viewport.transform.SetParent(scrollRoot.transform, false);
        Stretch(viewport.GetComponent<RectTransform>());
        viewport.GetComponent<Image>().color = Color.white;
        viewport.GetComponent<Mask>().showMaskGraphic = false;

        GameObject content = new GameObject("CATALOGUE_CONTENT", typeof(RectTransform), typeof(VerticalLayoutGroup), typeof(ContentSizeFitter));
        content.transform.SetParent(viewport.transform, false);

        RectTransform contentRect = content.GetComponent<RectTransform>();
        contentRect.anchorMin = new Vector2(0, 1);
        contentRect.anchorMax = new Vector2(1, 1);
        contentRect.pivot = new Vector2(.5f, 1);
        contentRect.sizeDelta = Vector2.zero;

        VerticalLayoutGroup vertical = content.GetComponent<VerticalLayoutGroup>();
        vertical.padding = new RectOffset(24, 24, 22, 28);
        vertical.spacing = 18;
        vertical.childControlWidth = true;
        vertical.childControlHeight = true;
        vertical.childForceExpandWidth = true;
        vertical.childForceExpandHeight = false;
        content.GetComponent<ContentSizeFitter>().verticalFit = ContentSizeFitter.FitMode.PreferredSize;

        ScrollRect scroll = scrollRoot.GetComponent<ScrollRect>();
        scroll.viewport = viewport.GetComponent<RectTransform>();
        scroll.content = contentRect;
        scroll.horizontal = false;
        scroll.vertical = true;
        scroll.movementType = ScrollRect.MovementType.Clamped;
        scroll.scrollSensitivity = 60f;

        int total = 0;
        int[] categoryCounts = new int[Categories.Length];
        string[][] categoryGuids = new string[Categories.Length][];

        for (int i = 0; i < Categories.Length; i++)
        {
            string folder = "Assets/Game/Units/Database/" + Categories[i];
            categoryGuids[i] = AssetDatabase.FindAssets("t:UnitDefinition", new[] { folder });
            Array.Sort(categoryGuids[i]);
            categoryCounts[i] = categoryGuids[i].Length;
            total += categoryCounts[i];
        }

        BuildCategoryNavigation(content.transform, categoryCounts);

        for (int i = 0; i < Categories.Length; i++)
        {
            BuildCategory(content.transform, Categories[i], categoryGuids[i]);
        }

        BuildFooter(content.transform, total);

        EditorSceneManager.MarkSceneDirty(scene);
        EditorSceneManager.SaveScene(scene);

        Debug.Log("[STORE] AAA catalogue built. " + total + " unit cards across six categories.");
    }

