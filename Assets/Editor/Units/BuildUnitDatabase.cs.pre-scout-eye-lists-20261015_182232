    private static void SetFloat(SerializedObject so, string propertyPath, float value)
    {
        SerializedProperty property = so.FindProperty(propertyPath);
        if (property != null && property.propertyType == SerializedPropertyType.Float)
            property.floatValue = value;
        else
            Debug.LogWarning("Scout Eye float property not found: " + propertyPath);
    }
    private static void SetInt(SerializedObject so, string propertyPath, int value)
    {
        SerializedProperty property = so.FindProperty(propertyPath);
        if (property != null && property.propertyType == SerializedPropertyType.Integer)
            property.intValue = value;
        else
            Debug.LogWarning("Scout Eye integer property not found: " + propertyPath);
    }
    private static void SetBool(SerializedObject so, string propertyPath, bool value)
    {
        SerializedProperty property = so.FindProperty(propertyPath);
        if (property != null && property.propertyType == SerializedPropertyType.Boolean)
            property.boolValue = value;
        else
            Debug.LogWarning("Scout Eye boolean property not found: " + propertyPath);
    }
    private static void FillPrimitiveProperties(
        SerializedObject so,
        string unitName,
        string category)
    {
        SerializedProperty it = so.GetIterator();

        bool enterChildren = true;

        while (it.NextVisible(enterChildren))
        {
            enterChildren = false;

            if (it.propertyType == SerializedPropertyType.String &&
                it.name != "unitId" &&
                it.name != "displayName" &&
                it.name != "role" &&
                it.name != "tier" &&
                it.name != "status")
            {
                it.stringValue =
                    unitName + " " + Pretty(it.name);
            }
            else if (it.propertyType == SerializedPropertyType.Float)
            {
                it.floatValue = DefaultFloat(it.name, category);
            }
            else if (it.propertyType == SerializedPropertyType.Integer)
            {
                it.intValue = DefaultInt(it.name, category);
            }
            else if (it.propertyType == SerializedPropertyType.Boolean)
            {
                it.boolValue = true;
            }
        }
    }

    private static float DefaultFloat(string field, string category)
    {
        string n = field.ToLowerInvariant();

        if (n.Contains("length")) return 3f;
        if (n.Contains("width")) return 2f;
        if (n.Contains("height")) return 1f;
        if (n.Contains("mass")) return 1000f;
        if (n.Contains("capacity")) return 1000f;
        if (n.Contains("range")) return 1000f;
        if (n.Contains("speed")) return 15f;
        if (n.Contains("acceleration")) return 5f;
        if (n.Contains("integrity")) return 1000f;
        if (n.Contains("armor")) return 0.5f;
        if (n.Contains("probability")) return 0.75f;
        if (n.Contains("efficiency")) return 0.8f;
        if (n.Contains("confidence")) return 0.8f;
        if (n.Contains("accuracy")) return 0.8f;
        if (n.Contains("aggression")) return 0.5f;
        if (n.Contains("caution")) return 0.75f;
        if (n.Contains("persistence")) return 0.75f;
        if (n.Contains("threshold")) return 0.5f;
        if (n.Contains("rating")) return 5f;
        if (n.Contains("percent")) return 80f;
        if (n.Contains("latency")) return 0.05f;
        if (n.Contains("seconds")) return 30f;
        if (n.Contains("hours")) return 100f;

        return 1f;
    }

    private static int DefaultInt(string field, string category)
    {
        string n = field.ToLowerInvariant();

        if (n.Contains("cost")) return 1000;
        if (n.Contains("points")) return 1000;
        if (n.Contains("quantity")) return 10;
        if (n.Contains("level")) return 1;
        if (n.Contains("size")) return 1;
        if (n.Contains("capacity")) return 5;
        if (n.Contains("threat")) return 5;
        if (n.Contains("relay")) return 2;

        return 1;
    }

    private static void SetString(
        SerializedObject so,
        string name,
        string value)
    {
        SerializedProperty p = so.FindProperty(name);

        if (p != null)
            p.stringValue = value;
    }

    private static string Pretty(string value)
    {
        if (string.IsNullOrEmpty(value))
            return "";

        return value
            .Replace("_", " ")
            .Replace("Meters", " Range")
            .Replace("Seconds", " Time");
    }

    private static void BuildDatabase()
    {
        string path = Root + "/UnitDatabase.asset";

        UnitDatabase db =
            AssetDatabase.LoadAssetAtPath<UnitDatabase>(path);

        if (db == null)
        {
            db = ScriptableObject.CreateInstance<UnitDatabase>();
            AssetDatabase.CreateAsset(db, path);
        }

        SerializedObject so = new SerializedObject(db);
        SerializedProperty list = so.FindProperty("units");

        if (list == null)
            throw new Exception("UnitDatabase.units was not found.");

        list.ClearArray();

        foreach (string entry in Units)
        {
            string[] p = entry.Split('|');

            string assetPath =
                Root + "/" +
                p[2] + "/" +
                p[1].Replace(" ", "_") +
                ".asset";

            UnitDefinition unit =
                AssetDatabase.LoadAssetAtPath<UnitDefinition>(assetPath);

            if (unit == null)
                throw new Exception("Missing unit asset: " + assetPath);

            int index = list.arraySize;
            list.InsertArrayElementAtIndex(index);
            list.GetArrayElementAtIndex(index).objectReferenceValue = unit;
        }

        so.ApplyModifiedPropertiesWithoutUndo();
        EditorUtility.SetDirty(db);
    }

    private static void SyncRuntimeDatabase()
    {
        const string runtimePath = "Assets/Resources/UnitDatabase.asset";

        UnitDatabase source =
            AssetDatabase.LoadAssetAtPath<UnitDatabase>(
                Root + "/UnitDatabase.asset");

        UnitDatabase target =
            AssetDatabase.LoadAssetAtPath<UnitDatabase>(runtimePath);

        if (source == null)
            throw new Exception("Canonical UnitDatabase.asset was not found.");

        if (target == null)
            throw new Exception("Runtime UnitDatabase.asset was not found.");

        SerializedObject sourceObject = new SerializedObject(source);
        SerializedObject targetObject = new SerializedObject(target);

        SerializedProperty sourceUnits = sourceObject.FindProperty("units");
        SerializedProperty targetUnits = targetObject.FindProperty("units");

        if (sourceUnits == null || targetUnits == null)
            throw new Exception("UnitDatabase.units was not found during synchronization.");

        targetUnits.arraySize = sourceUnits.arraySize;

        for (int i = 0; i < sourceUnits.arraySize; i++)
        {
            targetUnits.GetArrayElementAtIndex(i).objectReferenceValue =
                sourceUnits.GetArrayElementAtIndex(i).objectReferenceValue;
        }

        targetObject.ApplyModifiedPropertiesWithoutUndo();

        target.RebuildLookup();
        EditorUtility.SetDirty(target);

        Debug.Log(
            "[UNIT DATABASE BUILDER] Runtime database synchronized // " +
            sourceUnits.arraySize + " units");
    }

    private static void EnsureFolder(string path)
    {
        if (AssetDatabase.IsValidFolder(path))
            return;

        string[] parts = path.Split('/');

        string current = parts[0];

        for (int i = 1; i < parts.Length; i++)
        {
            string next = current + "/" + parts[i];

            if (!AssetDatabase.IsValidFolder(next))
                AssetDatabase.CreateFolder(current, parts[i]);

            current = next;
        }
    }
