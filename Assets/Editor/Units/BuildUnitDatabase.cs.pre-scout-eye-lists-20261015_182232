    [MenuItem("Obsidian Protocol/Units/BUILD ALL UNIT DATABASE")]
    public static void Build()
    {
        try
        {
            EnsureFolder(Root);

            int created = 0;
            int updated = 0;

            foreach (string entry in Units)
            {
                string[] p = entry.Split('|');

                if (BuildUnit(p[0], p[1], p[2]))
                    created++;
                else
                    updated++;
            }

            BuildDatabase();
            SyncRuntimeDatabase();

            AssetDatabase.SaveAssets();
            AssetDatabase.Refresh();

            Debug.Log(
                $"UNIT DATABASE COMPLETE â€” {Units.Length} units | Created: {created} | Updated: {updated}");
        }
        catch (Exception e)
        {
            Debug.LogError("UNIT DATABASE BUILD FAILED: " + e);
        }
    }

    private static bool BuildUnit(string id, string name, string category)
    {
        string folder = Root + "/" + category;
        EnsureFolder(folder);

        string safeName = name.Replace(" ", "_");
        string path = folder + "/" + safeName + ".asset";

        UnitDefinition unit =
            AssetDatabase.LoadAssetAtPath<UnitDefinition>(path);

        bool created = false;

        if (unit == null)
        {
            unit = ScriptableObject.CreateInstance<UnitDefinition>();
            AssetDatabase.CreateAsset(unit, path);
            created = true;
        }

        SerializedObject so = new SerializedObject(unit);

        if (id == "obs-air-scout-eye")
        {
            ConfigureScoutEye(so);
        }
        else
        {
            SetString(so, "unitId", id);
            SetString(so, "displayName", name);
            SetString(so, "role", category + " Unit");
            SetString(so, "tier", "Standard");
            SetString(so, "status", "ACTIVE");

            SerializedProperty categoryProp = so.FindProperty("category");
            if (categoryProp != null)
                categoryProp.enumValueIndex =
                    Array.IndexOf(
                        Enum.GetNames(typeof(UnitCategory)),
                        category);

            FillPrimitiveProperties(so, name, category);
        }

        so.ApplyModifiedPropertiesWithoutUndo();
        EditorUtility.SetDirty(unit);

        return created;
    }


