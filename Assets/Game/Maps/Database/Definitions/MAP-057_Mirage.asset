%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0263df275083eba45b37ab9636c8dcbf, type: 3}
  m_Name: MAP-057_Mirage
  m_EditorClassIdentifier: Assembly-CSharp::ObsidianProtocol.Game.Maps.MapDefinition
  mapId: MAP-057
  displayName: Mirage
  environment: Desert / Military
  warfareFocus: Deception & Information Warfare
  executiveSummary: "Mirage is a military desert battlefield built for deception, misinformation, sensor manipulation, and autonomous counter-recon operations. The terrain features heat-warped flats, dune fields, military outposts, radar stations, decoy emplacements, false infrastructure, buried cables, and canyon-edge observation posts. The map emphasizes autonomous deception logic, sensor-fusion under mirage distortion, comms-relay spoofing, and logistics under extreme heat and visibility anomalies. In AR, the map anchors at ~4\u20135 m viewing distance, covering a 10\xD710 m physical area representing ~1 km\xB2 of desert-military terrain. Key features include decoy zones, false sensor signatures, long-range mirage corridors, and information-warfare-driven engagements."
  designGoals:
  - name: Deception-Driven Warfare
    description: False signals, decoy units, spoofed radar returns, holographic projections, and misinformation traps manipulate enemy perception.
  - name: Information Warfare & Sensor Manipulation
    description: Heat shimmer, mirage distortion, dust haze, and thermal plumes degrade sensors while specialized units generate false signatures, jam communications, and create phantom targets.
  - name: Autonomy & Counter-Recon Logic
    description: Autonomous units choose routes based on sensor clarity, deception zones, false positives, and enemy spoofing attempts, adapting to misleading data and prioritizing verification.
  - name: Desert Military Operations
    description: Long-range fire, drone reconnaissance, armored pushes, and radar-guided strikes dominate. Outposts and radar stations serve as both real and decoy objectives.
  - name: Logistics & Resources
    description: Fuel depots, communications bunkers, and desert roads serve as resupply nodes. Convoys must navigate exposed flats and avoid ambush-prone deception corridors.
  deployment: Fixed deployment budget ~10,000 points. Blue deploys from the southwest dune-base staging area; Red deploys from the northeast radar-spire command.
  ar:
    viewingDistance: "~4\u20135 m"
    physicalArea: "10\xD710 m"
    representedArea: "~1 km\xB2"
    scale: 1:100
    fov: "~53\xB0 diagonal"
    resolution: "1920\xD71080 per eye"
    tracking: Inside-out tracking detects horizontal planes. Depth mesh, if available, provides limited occlusion. Virtual objects render over the real-world view with minimal real-world occlusion.
    interaction: Phone pointer for pan/zoom; HUD as screen-space widgets.
  coordinateSystem: "1000\xD71000 grid; 1 unit \u2248 1 m; origin (0,0) southwest corner."
  keyLocations:
  - name: Blue HQ (Dune-Base Command)
    coordinate: (0,0)
    sizeOrElevation: "150\xD7150 m"
    description: Armored vehicles, drone pads, and deception-unit staging.
  - name: Red HQ (Radar-Spire Command)
    coordinate: (1000,1000)
    sizeOrElevation: "150\xD7150 m"
    description: Elevated bunker with radar mast, AA emplacements, and sensor arrays.
  - name: Central Mirage Flats
    coordinate: (500,450)
    sizeOrElevation: "300\xD7300 m"
    description: Heat shimmer, false signatures, long-range fire lanes, and deception traps.
  - name: Comms Bunker Cluster
    coordinate: (250,800)
    sizeOrElevation: "120\xD7120 m"
    description: Servers, generators, decoy transmitters, and interior flanking routes.
  - name: Canyon Observation Network
    coordinate: (800,300)
    sizeOrElevation: "200\xD7200 m"
    description: High-ground overwatch, sensor triangulation, and counter-recon vantage points.
  - name: Deception Corridor
    coordinate: "(0,450 \u2192 400,900)"
    sizeOrElevation: "\u2014"
    description: Primary misinformation zone containing false radar returns and phantom units.
  - name: Desert Road Route
    coordinate: "(300,0 \u2192 450,350)"
    sizeOrElevation: "\u2014"
    description: Safer but predictable route vulnerable to spoofed ambushes.
  - name: Radar Relay A
    coordinate: (650,150)
    sizeOrElevation: +240 m
    description: Long-range sensor vantage point.
  - name: Radar Relay B
    coordinate: (150,650)
    sizeOrElevation: +260 m
    description: Communications relay hub and deception-control node.
  - name: Neutral Forward Outpost
    coordinate: (500,950)
    sizeOrElevation: "\u2014"
    description: Drone resupply zone.
  chokepointsAndSightlines:
  - name: Deception Corridor
    description: Major chokepoint filled with false signals and spoofed targets.
  - name: Canyon Observation Network
    description: Extreme long-range sightlines ideal for counter-recon and sensor triangulation.
  - name: Mirage Flats
    description: Long-range engagements are distorted by heat shimmer and false signatures.
  - name: Desert Road Route
    description: Predictable but safe route vulnerable to deception-driven ambushes.
  - name: Radar Relay A
    description: Provides approximately 400 m of long-range sensor coverage; heat distortion and dust haze create fog-of-war pockets.
  terrain: Desert flats, dunes, canyons, roads, radar stations, and communications bunkers.
  vegetation: Sparse shrubs and desert grass.
  buildingsAndProps: 'Military: AA guns, radar dishes, bunkers, decoy towers. Industrial: generators, pipelines, communications arrays. Logistics: trucks, crates, fuel drums, drones.'
  effects: Heat shimmer, dust storms, mirage distortion, and false holographic signatures.
  audio: Wind, distant machinery, radio chatter, and drone hum.
  lodBudget:
  - category: Desert Terrain
    count: 3
    trianglesPerItem: 200000
    totalTriangles: 600000
  - category: Industrial/Military
    count: 4
    trianglesPerItem: 80000
    totalTriangles: 320000
  - category: Buildings/Military
    count: 15
    trianglesPerItem: 50000
    totalTriangles: 750000
  - category: Roads/Paths
    count: 4
    trianglesPerItem: 30000
    totalTriangles: 120000
  - category: Props
    count: 50
    trianglesPerItem: 10000
    totalTriangles: 500000
  textureBudget: "2048\xB2 for terrain/buildings; 1024\xB2 for props; DXT1/5 compression; target \u2264100 MB."
  engineAndPlugins: Unreal ARTemplate + Nreal SDK (XREAL). ARKit/ARCore enabled.
  rendering: Forward renderer, stationary lights, baked GI, aggressive culling.
  anchors: Single spatial anchor for entire map.
  interaction: Phone pointer for pan/zoom; HUD as screen-space widgets.
  multiplayer: Client-server architecture; offload AI/physics to server.
  milestones:
  - name: 1. Prototype Layout
    description: Block-out mirage flats, canyon network, communications bunkers, and AR anchor test.
  - name: 2. Core Systems
    description: NavMesh, deception autonomy behaviors, and sensor-spoofing logic.
  - name: 3. AR Integration
    description: Anchors, plane detection, and basic interactivity.
  - name: 4. Content Fill
    description: Final models, textures, lighting, and audio.
  - name: 5. Gameplay & Polish
    description: Objectives, balance, heat shimmer, dust haze, and holographic decoy effects.
  - name: 6. Testing & QA
    description: Multiplayer stress test and sensor validation.
  testing:
  - name: Autonomy
    description: Verify deception-aware navigation, counter-recon behavior, and hazard avoidance.
  - name: Comms/Sensors
    description: Test relay destruction, fog-of-war updates, and line-of-sight checks under mirage distortion.
  - name: Performance
    description: "Target \u226560 Hz AR rendering on the target device."
  - name: QA
    description: Navigation, deception logic, deployment budget enforcement, anchor drift, and sensor accuracy.
