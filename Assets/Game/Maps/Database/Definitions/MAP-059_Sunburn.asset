%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0263df275083eba45b37ab9636c8dcbf, type: 3}
  m_Name: MAP-059_Sunburn
  m_EditorClassIdentifier: Assembly-CSharp::ObsidianProtocol.Game.Maps.MapDefinition
  mapId: MAP-059
  displayName: Sunburn
  environment: Desert / Canyon
  warfareFocus: Long-Range Fire & Air Superiority
  executiveSummary: "Sunburn is a blistering desert-canyon battlefield built for long-range firepower, air superiority, high-altitude reconnaissance, and autonomous maneuvering across open and vertical terrain. The environment features sandstone canyons, wind-carved ridges, dry riverbeds, elevated plateaus, abandoned mining sites, and sparse desert settlements. The map emphasizes autonomous long-range targeting logic, air-ground coordination, sensor-fusion under heat distortion, and logistics under extreme desert conditions. In AR, the map anchors at ~4\u20135 m viewing distance, covering a 10\xD710 m physical area representing ~1 km\xB2 of canyon-desert terrain. Key features include canyon sightlines, high-ground air corridors, long-range artillery zones, and heat-driven sensor degradation."
  designGoals:
  - name: Long-Range Desert Firepower
    description: Sunburn prioritizes snipers, artillery, missile vehicles, and long-range drones. Open desert flats and canyon ridges create extreme sightlines.
  - name: Air Superiority & High-Altitude Recon
    description: Aircraft, VTOLs, and drones dominate the vertical dimension. Air corridors between canyon walls define reconnaissance, interception, and strike patterns.
  - name: Canyon Maneuvering & Vertical Combat
    description: Ground units navigate narrow canyon passes, elevated ridges, and dry riverbeds. Verticality creates ambush zones and long-range overwatch positions.
  - name: Autonomy & Heat-Aware Pathfinding
    description: Autonomous units choose routes based on heat shimmer, elevation, cover scarcity, and sensor clarity. Units avoid exposed flats during peak heat unless necessary.
  - name: Sensor & Information Warfare
    description: Heat distortion, dust storms, mirage effects, and thermal plumes degrade sensors. Relay towers on ridges restore clarity; destroying relays creates blind pockets.
  - name: Logistics & Resources
    description: Fuel depots, mining stations, and desert outposts serve as resupply nodes. Convoys must navigate exposed roads and avoid ambush-prone canyon passes.
  deployment: Fixed deployment budget ~10,000 points. Blue deploys from the southwest dry-river staging zone; Red deploys from the northeast ridge-top command.
  ar:
    viewingDistance: "~4\u20135 m"
    physicalArea: "10\xD710 m"
    representedArea: "~1 km\xB2"
    scale: 1:100
    fov: "~53\xB0 diagonal"
    resolution: "1920\xD71080 per eye"
    tracking: Inside-out tracking detects horizontal planes. Depth mesh, if available, provides limited occlusion. Virtual objects render over the real-world view with minimal real-world occlusion.
    interaction: Phone pointer for pan/zoom; HUD as screen-space widgets.
  coordinateSystem: "1000\xD71000 grid; 1 unit \u2248 1 m; origin (0,0) southwest corner."
  keyLocations:
  - name: Blue HQ (Dry-River Staging Zone)
    coordinate: (0,0)
    sizeOrElevation: "150\xD7150 m"
    description: Cargo crates, armored vehicles, and drone pads.
  - name: Red HQ (Ridge-Top Command)
    coordinate: (1000,1000)
    sizeOrElevation: "150\xD7150 m"
    description: Elevated bunker with radar mast, AA emplacements, and long-range sensors.
  - name: Central Canyon Basin
    coordinate: (500,450)
    sizeOrElevation: "300\xD7300 m"
    description: Wide canyon floor with long sightlines, heat shimmer, and artillery duels.
  - name: Mining Station Depot
    coordinate: (250,800)
    sizeOrElevation: "120\xD7120 m"
    description: Abandoned machinery, fuel tanks, and interior flanking routes.
  - name: Ridge Network
    coordinate: (800,300)
    sizeOrElevation: "200\xD7200 m"
    description: High-ground overwatch, sniper nests, and air-corridor control.
  - name: Canyon Pass Corridor
    coordinate: "(0,450 \u2192 400,900)"
    sizeOrElevation: "\u2014"
    description: Primary chokepoint; narrow and exposed, making it ideal for ambushes.
  - name: Desert Road Route
    coordinate: "(300,0 \u2192 450,350)"
    sizeOrElevation: "\u2014"
    description: Safer but predictable route vulnerable to ridge overwatch.
  - name: Ridge Relay A
    coordinate: (650,150)
    sizeOrElevation: +240 m
    description: Long-range sensor vantage point.
  - name: Ridge Relay B
    coordinate: (150,650)
    sizeOrElevation: +260 m
    description: Communications relay hub and air-control node.
  - name: Neutral Forward Outpost
    coordinate: (500,950)
    sizeOrElevation: "\u2014"
    description: Drone resupply zone.
  chokepointsAndSightlines:
  - name: Canyon Pass Corridor
    description: Major chokepoint; controlling it determines ground movement.
  - name: Ridge Network
    description: Extreme long-range sightlines ideal for snipers and air-ground coordination.
  - name: Canyon Basin
    description: Long-range artillery and missile engagements; heat shimmer affects accuracy.
  - name: Desert Road Route
    description: Predictable but safe route vulnerable to ridge overwatch.
  - name: Ridge Relay A
    description: Provides approximately 400 m of long-range sensor coverage. Heat distortion and dust storms create fog-of-war pockets.
  terrain: Canyons, ridges, desert flats, dry riverbeds, and mining stations.
  vegetation: Sparse shrubs, desert grass, and small trees.
  buildingsAndProps: 'Military: AA guns, radar dishes, bunkers. Industrial: mining equipment, generators, pipelines. Logistics: trucks, crates, fuel drums, drones.'
  effects: Dust storms, heat shimmer, mirage distortion, and wind gusts.
  audio: Wind, distant machinery, radio chatter, and aircraft.
  lodBudget:
  - category: Canyon/Ridge Terrain
    count: 3
    trianglesPerItem: 200000
    totalTriangles: 600000
  - category: Industrial/Mining
    count: 4
    trianglesPerItem: 80000
    totalTriangles: 320000
  - category: Buildings/Military
    count: 15
    trianglesPerItem: 50000
    totalTriangles: 750000
  - category: Roads/Paths
    count: 4
    trianglesPerItem: 30000
    totalTriangles: 120000
  - category: Props
    count: 50
    trianglesPerItem: 10000
    totalTriangles: 500000
  textureBudget: "2048\xB2 for terrain/buildings; 1024\xB2 for props; DXT1/5 compression; target \u2264100 MB."
  engineAndPlugins: Unreal ARTemplate + Nreal SDK (XREAL). ARKit/ARCore enabled.
  rendering: Forward renderer, stationary lights, baked GI, aggressive culling.
  anchors: Single spatial anchor for entire map.
  interaction: Phone pointer for pan/zoom; HUD as screen-space widgets.
  multiplayer: Client-server architecture; offload AI/physics to server.
  milestones:
  - name: 1. Prototype Layout
    description: Block-out canyon basin, ridges, mining station, and AR anchor test.
  - name: 2. Core Systems
    description: NavMesh, long-range autonomy behaviors, and air-ground coordination.
  - name: 3. AR Integration
    description: Anchors, plane detection, and basic interactivity.
  - name: 4. Content Fill
    description: Final models, textures, lighting, and audio.
  - name: 5. Gameplay & Polish
    description: Objectives, balance, dust storms, and heat shimmer VFX.
  - name: 6. Testing & QA
    description: Multiplayer stress test and sensor validation.
  testing:
  - name: Autonomy
    description: Verify long-range targeting, air-ground coordination, and heat-aware navigation.
  - name: Comms/Sensors
    description: Test relay destruction, fog-of-war updates, and line-of-sight checks under heat distortion.
  - name: Performance
    description: "Target \u226560 Hz AR rendering on the target device."
  - name: QA
    description: Navigation, long-range logic, deployment budget enforcement, anchor drift, and sensor accuracy.
