%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0263df275083eba45b37ab9636c8dcbf, type: 3}
  m_Name: MAP-060_Canopy
  m_EditorClassIdentifier: Assembly-CSharp::ObsidianProtocol.Game.Maps.MapDefinition
  mapId: MAP-060
  displayName: Canopy
  environment: Dense Jungle
  warfareFocus: Recon & Autonomous Search
  executiveSummary: "Canopy is an ultra-dense tropical jungle reconnaissance battlefield built for autonomous search, stealth movement, sensor-limited engagements, and foliage-driven concealment. The terrain features towering canopy layers, tangled undergrowth, vine-choked ravines, mossy cliffs, hidden trails, abandoned outposts, and river-cut gorges. The map emphasizes autonomous recon logic, sensor-fusion under heavy occlusion, comms-relay warfare, and logistics under extreme vegetation density. In AR, the map anchors at ~4\u20135 m viewing distance, covering a 10\xD710 m physical area representing ~1 km\xB2 of deep-jungle terrain. Key features include multi-layer canopy concealment, autonomous search corridors, unpredictable sightlines, and stealth-heavy engagements."
  designGoals:
  - name: Dense-Jungle Reconnaissance
    description: Canopy prioritizes scouting, tracking, and stealth infiltration. Vegetation density creates natural blind zones, forcing reliance on autonomous recon units and sensor triangulation.
  - name: Autonomous Search & Pathfinding
    description: Units navigate canopy shadows, narrow trails, root-choked paths, and vine-covered ravines. Autonomous logic selects routes based on concealment, sensor clarity, and terrain stability.
  - name: Concealment & Ambush Warfare
    description: Foliage, canopy layers, and humidity fog create stealth pockets. Ambushes, flanking, and sudden close-range engagements dominate.
  - name: Sensor & Information Warfare
    description: Humidity, fog, vegetation clutter, thermal distortion, and canopy occlusion degrade sensors. Relay towers on cliffs restore clarity; destroying relays creates blind pockets.
  - name: Logistics & Resources
    description: Fuel caches, abandoned outposts, and river docks serve as resupply nodes. Convoys must navigate narrow jungle trails and avoid ambush-prone canopy corridors.
  deployment: Fixed deployment budget ~10,000 points. Blue deploys from the southwest river-trail camp; Red deploys from the northeast cliffside recon tower.
  ar:
    viewingDistance: "~4\u20135 m"
    physicalArea: "10\xD710 m"
    representedArea: "~1 km\xB2"
    scale: 1:100
    fov: "~53\xB0 diagonal"
    resolution: "1920\xD71080 per eye"
    tracking: Inside-out tracking detects horizontal planes. Depth mesh, if available, provides limited occlusion. Virtual objects render over the real-world view with minimal real-world occlusion.
    interaction: Phone pointer for pan/zoom; HUD as screen-space widgets.
  coordinateSystem: "1000\xD71000 grid; 1 unit \u2248 1 m; origin (0,0) southwest corner."
  keyLocations:
  - name: Blue HQ (River-Trail Recon Camp)
    coordinate: (0,0)
    sizeOrElevation: "150\xD7150 m"
    description: Boats, crates, recon drones, and jungle staging.
  - name: Red HQ (Cliffside Recon Tower)
    coordinate: (1000,1000)
    sizeOrElevation: "150\xD7150 m"
    description: Elevated bunker with radar mast, thermal relays, and canopy overwatch.
  - name: Central Canopy Basin
    coordinate: (500,450)
    sizeOrElevation: "300\xD7300 m"
    description: Dense canopy, fog pockets, unpredictable sightlines, and stealth-heavy combat.
  - name: Abandoned Outpost Cluster
    coordinate: (250,800)
    sizeOrElevation: "120\xD7120 m"
    description: Ruins, generators, and interior flanking routes.
  - name: Ridge-Top Canopy Network
    coordinate: (800,300)
    sizeOrElevation: "200\xD7200 m"
    description: High-ground overwatch, tree-top concealment, and stealth movement.
  - name: Recon Corridor
    coordinate: "(0,450 \u2192 400,900)"
    sizeOrElevation: "\u2014"
    description: Heavy vegetation zone producing extreme sensor degradation.
  - name: Hidden Trail Route
    coordinate: "(300,0 \u2192 450,350)"
    sizeOrElevation: "\u2014"
    description: Safer but slower route with root hazards and heavy vegetation cover.
  - name: Cliff Relay A
    coordinate: (650,150)
    sizeOrElevation: +240 m
    description: Long-range sensor vantage point.
  - name: Cliff Relay B
    coordinate: (150,650)
    sizeOrElevation: +260 m
    description: Communications relay hub and recon-monitoring node.
  - name: Neutral Forward Outpost
    coordinate: (500,950)
    sizeOrElevation: "\u2014"
    description: Drone resupply zone.
  chokepointsAndSightlines:
  - name: Recon Corridor
    description: Severe visibility loss; ideal for stealth ambushes and sensor deception.
  - name: Ridge-Top Canopy Network
    description: Interior flanking routes with unpredictable cover caused by dense foliage.
  - name: Canopy Basin
    description: Long-range engagements are broken by vegetation while humidity reduces accuracy.
  - name: Hidden Trail Route
    description: Predictable but safe route vulnerable to overwatch from ridges.
  - name: Cliff Relay A
    description: Provides approximately 300 m of long-range sensor coverage. Fog and canopy shadows create fog-of-war pockets.
  terrain: Canopy layers, cliffs, rivers, mud trails, and abandoned outposts.
  vegetation: Dense trees, vines, ferns, underbrush, and mossy cliffs.
  buildingsAndProps: 'Military: radar dishes, thermal relays, bunkers. Rural: huts, bridges, wooden structures. Logistics: trucks, crates, fuel drums, boats, drones.'
  effects: Fog, humidity haze, rain, canopy shadows, and mud splashes.
  audio: Insects, rainfall, distant machinery, river flow, and radio chatter.
  lodBudget:
  - category: Jungle Terrain
    count: 3
    trianglesPerItem: 200000
    totalTriangles: 600000
  - category: Rural/Industrial
    count: 4
    trianglesPerItem: 80000
    totalTriangles: 320000
  - category: Buildings/Rural
    count: 15
    trianglesPerItem: 50000
    totalTriangles: 750000
  - category: Roads/Paths
    count: 4
    trianglesPerItem: 30000
    totalTriangles: 120000
  - category: Props
    count: 50
    trianglesPerItem: 10000
    totalTriangles: 500000
  textureBudget: "2048\xB2 for terrain/buildings; 1024\xB2 for props; DXT1/5 compression; target \u2264100 MB."
  engineAndPlugins: Unreal ARTemplate + Nreal SDK (XREAL). ARKit/ARCore enabled.
  rendering: Forward renderer, stationary lights, baked GI, aggressive culling.
  anchors: Single spatial anchor for entire map.
  interaction: Phone pointer for pan/zoom; HUD as screen-space widgets.
  multiplayer: Client-server architecture; offload AI/physics to server.
  milestones:
  - name: 1. Prototype Layout
    description: Block-out canopy basin, ridges, outposts, and AR anchor test.
  - name: 2. Core Systems
    description: NavMesh, jungle autonomy behaviors, and recon logic.
  - name: 3. AR Integration
    description: Anchors, plane detection, and basic interactivity.
  - name: 4. Content Fill
    description: Final models, textures, lighting, and audio.
  - name: 5. Gameplay & Polish
    description: Objectives, balance, fog, humidity haze, and canopy-shadow VFX.
  - name: 6. Testing & QA
    description: Multiplayer stress test and sensor validation.
  testing:
  - name: Autonomy
    description: Verify jungle navigation, recon-aware pathfinding, and hazard avoidance.
  - name: Comms/Sensors
    description: Test relay destruction, fog-of-war updates, and line-of-sight checks under canopy occlusion.
  - name: Performance
    description: "Target \u226560 Hz AR rendering on the target device."
  - name: QA
    description: Navigation, recon logic, deployment budget enforcement, anchor drift, and sensor accuracy.
