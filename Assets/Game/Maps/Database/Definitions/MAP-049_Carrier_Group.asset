    totalTriangles: 500000
  textureBudget: "2048\xB2 for ships/terrain; 1024\xB2 for props; DXT1/5; target \u2264100 MB."
  engineAndPlugins: Unreal ARTemplate + Nreal SDK (XREAL). ARKit/ARCore enabled.
  rendering: Forward renderer, stationary lights, baked GI, aggressive culling.
  anchors: Single spatial anchor for entire map.
  interaction: 
  multiplayer: Client-server architecture; offload AI/physics to server.
  milestones:
  - name: 1. Prototype Layout
    description: Block-out ocean basin, ship positions, radar picket line, AR anchor test.
  - name: 2. Core Systems
    description: NavMesh (sea + air), missile autonomy behaviors, radar logic.
  - name: 3. AR Integration
    description: Anchors, plane detection, basic interactivity.
  - name: 4. Content Fill
    description: Final models, textures, lighting, audio.
  - name: 5. Gameplay & Polish
    description: Objectives, balance, VFX (missile trails, radar waves).
  - name: 6. Testing & QA
    description: Multiplayer stress test, sensor validation.
  testing:
  - name: 
    description: Verify air-sea coordination, missile-aware routing, hazard avoidance.
  - name: 
    description: Test relay destruction, fog-of-war updates, LOS checks under EW interference.
  - name: 
    description: "\u226560 Hz AR render on target device."
  - name: 
    description: Navigation, naval logic, deployment budget enforcement, anchor drift, sensor accuracy.
