  m_Script: {fileID: 11500000, guid: 0263df275083eba45b37ab9636c8dcbf, type: 3}
  m_Name: MAP-047_Blind_Zone
  m_EditorClassIdentifier: Assembly-CSharp::ObsidianProtocol.Game.Maps.MapDefinition
  mapId: MAP-047
  displayName: Blind Zone
  environment: Dense Terrain
  warfareFocus: Sensor denial & information warfare
  executiveSummary: Dense-terrain electronic-warfare battlefield built for sensor denial, information manipulation, autonomous counter-recon behavior, and close-range tactical deception. Features tangled vegetation, jagged rock formations, narrow ravines, abandoned bunkers, buried cabling, fog pockets, and natural EM-disruptive minerals.
  designGoals:
  - name: Sensor Denial Warfare
    description: Jamming, occlusion, interference, false signatures, and sensor blackout pockets. Units operate under partial or total sensor loss.
  - name: Information Manipulation & Deception
    description: EW drones, false-signal emitters, spoof beacons, and decoy units reshape the tactical landscape.
  - name: Autonomous Counter-EW Routing
    description: Routes based on signal strength, interference pockets, terrain occlusion, and fallback relay availability; units adapt to misleading data.
  - name: Dense-Terrain Combat
    description: Close-range engagements dominate; vegetation, rocks, and fog create stealth zones and unpredictable movement corridors.
  - name: Logistics & Resources
    description: Fuel caches, bunker stations, and buried cable hubs serve as resupply nodes; convoys navigate blackout corridors.
  deployment: Fixed deployment budget ~10,000 points. Blue deploys from southwest ravine gate; Red from northeast bunker-spire command.
  ar:
    viewingDistance: "~4\u20135 m"
    physicalArea: "10\xD710 m"
    representedArea: "~1 km\xB2"
    scale: 1:100
    fov: "~53\xB0 diagonal"
    resolution: "1920\xD71080 per eye"
    tracking: Inside-out horizontal plane tracking; depth mesh if available; minimal real-world occlusion.
    interaction: Phone pointer for pan/zoom; HUD as screen-space widgets.
  coordinateSystem: "1000\xD71000 grid; 1 unit \u2248 1 m; origin (0,0) southwest corner."
  keyLocations:
  - name: Blue HQ (Ravine Gate Command)
    coordinate: (0,0)
    sizeOrElevation: "150\xD7150 m"
    description: Armored vehicles, EW trucks, drone pads.
  - name: Red HQ (Bunker-Spire Command)
    coordinate: (1000,1000)
    sizeOrElevation: "150\xD7150 m"
    description: Elevated bunker with radar mast, EW arrays, AA emplacements.
  - name: Central Blind Basin
    coordinate: (500,450)
    sizeOrElevation: "300\xD7300 m"
    description: Dense vegetation, fog pockets, interference zones, close-range EW duels.
  - name: Cable Hub Cluster
    coordinate: (250,800)
    sizeOrElevation: "120\xD7120 m"
    description: Buried fiber lines, generators, interior flanking routes.
  - name: Ridge-Shadow Network
    coordinate: (800,300)
    sizeOrElevation: "200\xD7200 m"
    description: High-ground overwatch, signal triangulation, counter-EW vantage points.
  - name: Blackout Corridor
    coordinate: "(0,450 \u2192 400,900)"
    sizeOrElevation: "\u2014"
    description: Primary EW chokepoint; jamming fields, interference pockets, false signals.
  - name: Hidden Trail Route
    coordinate: "(300,0 \u2192 450,350)"
    sizeOrElevation: "\u2014"
    description: Safer but slow; rock hazards and vegetation cover.
  - name: Relay Node A
    coordinate: (650,150)
    sizeOrElevation: +240 m
    description: Long-range sensor vantage point.
  - name: Relay Node B
    coordinate: (150,650)
    sizeOrElevation: +260 m
    description: Comms relay hub and EW-control node.
  - name: Neutral Forward Outpost
    coordinate: (500,950)
    sizeOrElevation: "\u2014"
    description: Drone resupply zone.
  chokepointsAndSightlines:
  - name: Blackout Corridor
    description: Major chokepoint; filled with jamming fields and false signals.
  - name: Ridge-Shadow Network
    description: Extreme long-range sightlines; ideal for counter-EW and recon triangulation.
  - name: Blind Basin
    description: Long-range EW engagements distorted by interference and sensor loss.
  - name: Hidden Trail Route
    description: Predictable but safe; vulnerable to ridge overwatch.
  terrain: Ridges, ravines, dense vegetation, bunkers, cable hubs.
  vegetation: Dense trees, shrubs, ferns, underbrush.
  buildingsAndProps: 'Military: EW trucks, AA guns, radar dishes, bunkers. Industrial: generators, transformers, pipelines, relay nodes. Logistics: trucks, crates, fuel drums, drones.'
  effects: Signal distortion, interference waves, fog, dust, static bursts.
  audio: Wind, generator hum, static bursts, radio chatter.
  lodBudget:
  - category: Dense Terrain
    count: 3
