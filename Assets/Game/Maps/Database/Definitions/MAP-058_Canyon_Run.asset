%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0263df275083eba45b37ab9636c8dcbf, type: 3}
  m_Name: MAP-058_Canyon_Run
  m_EditorClassIdentifier: Assembly-CSharp::ObsidianProtocol.Game.Maps.MapDefinition
  mapId: MAP-058
  displayName: Canyon Run
  environment: Canyon / Highway
  warfareFocus: Mobility, Ambushes, Route Control
  executiveSummary: "Canyon Run is a high-speed canyon-highway battlefield built for mobility-focused combat, ambush tactics, route control, and autonomous maneuvering through narrow vertical terrain. The environment features winding canyon highways, cliffside overhangs, collapsed tunnels, dry riverbeds, abandoned checkpoints, and elevated ridgelines. The map emphasizes autonomous route-selection logic, sensor-fusion under dust and heat distortion, comms-relay warfare, and logistics under fast-moving highway conditions. In AR, the map anchors at ~4\u20135 m viewing distance, covering a 10\xD710 m physical area representing ~1 km\xB2 of canyon-highway terrain. Key features include ambush corridors, high-speed traversal lanes, cliffside overwatch, and choke-controlled mobility warfare."
  designGoals:
  - name: Mobility-Driven Combat
    description: Canyon Run prioritizes fast movement, convoy operations, and rapid flanking. Highway lanes allow high-speed traversal while canyon walls restrict lateral movement.
  - name: Ambush & Route Control
    description: Narrow passes, blind corners, and cliff overhangs create ideal ambush zones. Controlling key highway segments determines reinforcement flow.
  - name: Vertical Overwatch & Canyon Tactics
    description: Ridges and cliffs provide overwatch positions for snipers, artillery, and drones. Verticality shapes sightlines and engagement ranges.
  - name: Autonomy & Route-Selection Logic
    description: Autonomous units choose between highway lanes, cliffside trails, dry riverbeds, and tunnel bypasses while adapting to blocked roads, collapsed tunnels, and shifting ambush threats.
  - name: Sensor & Information Warfare
    description: Dust storms, heat shimmer, canyon occlusion, and thermal plumes degrade sensors. Ridge relay towers restore clarity; destroying relays creates blind pockets.
  - name: Logistics & Resources
    description: Fuel depots, checkpoints, and roadside maintenance yards serve as resupply nodes. Convoys must navigate exposed roads and avoid ambush-prone canyon passes.
  deployment: Fixed deployment budget ~10,000 points. Blue deploys from the southwest canyon highway gate; Red deploys from the northeast ridge-top command.
  ar:
    viewingDistance: "~4\u20135 m"
    physicalArea: "10\xD710 m"
    representedArea: "~1 km\xB2"
    scale: 1:100
    fov: "~53\xB0 diagonal"
    resolution: "1920\xD71080 per eye"
    tracking: Inside-out tracking detects horizontal planes. Depth mesh, if available, provides limited occlusion. Virtual objects render over the real-world view with minimal real-world occlusion.
    interaction: Phone pointer for pan/zoom; HUD as screen-space widgets.
  coordinateSystem: "1000\xD71000 grid; 1 unit \u2248 1 m; origin (0,0) southwest corner."
  keyLocations:
  - name: Blue HQ (Highway Gate Command)
    coordinate: (0,0)
    sizeOrElevation: "150\xD7150 m"
    description: Armored vehicles, drone pads, and convoy staging.
  - name: Red HQ (Ridge-Top Command Spire)
    coordinate: (1000,1000)
    sizeOrElevation: "150\xD7150 m"
    description: Elevated bunker with radar mast, AA emplacements, and long-range sensors.
  - name: Central Canyon Highway
    coordinate: (500,450)
    sizeOrElevation: "300\xD7300 m"
    description: High-speed traversal zone with long sightlines, ambush corners, and dust plumes.
  - name: Checkpoint Depot
    coordinate: (250,800)
    sizeOrElevation: "120\xD7120 m"
    description: Barricades, fuel tanks, repair bays, and interior flanking routes.
  - name: Ridge Network
    coordinate: (800,300)
    sizeOrElevation: "200\xD7200 m"
    description: High-ground overwatch with sniper nests and drone launch pads.
  - name: Ambush Corridor
    coordinate: "(0,450 \u2192 400,900)"
    sizeOrElevation: "\u2014"
    description: Primary chokepoint; narrow and exposed, making it ideal for ambushes.
  - name: Dry Riverbed Route
    coordinate: "(300,0 \u2192 450,350)"
    sizeOrElevation: "\u2014"
    description: Safer but slower route with unstable terrain and limited cover.
  - name: Ridge Relay A
    coordinate: (650,150)
    sizeOrElevation: +240 m
    description: Long-range sensor vantage point.
  - name: Ridge Relay B
    coordinate: (150,650)
    sizeOrElevation: +260 m
    description: Communications relay hub and overwatch control node.
  - name: Neutral Forward Outpost
    coordinate: (500,950)
    sizeOrElevation: "\u2014"
    description: Drone resupply zone.
  chokepointsAndSightlines:
  - name: Ambush Corridor
    description: Major chokepoint; controlling it determines convoy movement.
  - name: Ridge Network
    description: Extreme long-range sightlines ideal for overwatch and artillery.
  - name: Canyon Highway
    description: High-speed engagements where dust plumes affect accuracy.
  - name: Dry Riverbed Route
    description: Predictable but safer route vulnerable to ridge overwatch.
  - name: Ridge Relay A
    description: Provides approximately 350 m of long-range sensor coverage. Dust storms and heat shimmer create fog-of-war pockets.
  terrain: Canyons, ridges, highways, dry riverbeds, and checkpoints.
  vegetation: Sparse shrubs, desert grass, and small trees.
  buildingsAndProps: 'Military: AA guns, radar dishes, bunkers. Industrial: checkpoints, generators, pipelines. Logistics: trucks, crates, fuel drums, drones.'
  effects: Dust storms, heat shimmer, mirage distortion, and wind gusts.
  audio: Wind, engines, distant artillery, and radio chatter.
  lodBudget:
  - category: Canyon/Ridge Terrain
    count: 3
    trianglesPerItem: 200000
    totalTriangles: 600000
  - category: Industrial/Checkpoints
    count: 4
    trianglesPerItem: 80000
    totalTriangles: 320000
  - category: Buildings/Military
    count: 15
    trianglesPerItem: 50000
    totalTriangles: 750000
  - category: Roads/Paths
    count: 4
    trianglesPerItem: 30000
    totalTriangles: 120000
  - category: Props
    count: 50
    trianglesPerItem: 10000
    totalTriangles: 500000
  textureBudget: "2048\xB2 for terrain/buildings; 1024\xB2 for props; DXT1/5 compression; target \u2264100 MB."
  engineAndPlugins: Unreal ARTemplate + Nreal SDK (XREAL). ARKit/ARCore enabled.
  rendering: Forward renderer, stationary lights, baked GI, aggressive culling.
  anchors: Single spatial anchor for entire map.
  interaction: Phone pointer for pan/zoom; HUD as screen-space widgets.
  multiplayer: Client-server architecture; offload AI/physics to server.
  milestones:
  - name: 1. Prototype Layout
    description: Block-out canyon highway, ridges, checkpoints, and AR anchor test.
  - name: 2. Core Systems
    description: NavMesh, mobility autonomy behaviors, and ambush logic.
  - name: 3. AR Integration
    description: Anchors, plane detection, and basic interactivity.
  - name: 4. Content Fill
    description: Final models, textures, lighting, and audio.
  - name: 5. Gameplay & Polish
    description: Objectives, balance, dust storms, and heat shimmer VFX.
  - name: 6. Testing & QA
    description: Multiplayer stress test and sensor validation.
  testing:
  - name: Autonomy
    description: Verify mobility routing, ambush-aware navigation, and hazard avoidance.
  - name: Comms/Sensors
    description: Test relay destruction, fog-of-war updates, and line-of-sight checks under dust and heat distortion.
  - name: Performance
    description: "Target \u226560 Hz AR rendering on the target device."
  - name: QA
    description: Navigation, mobility logic, deployment budget enforcement, anchor drift, and sensor accuracy.
