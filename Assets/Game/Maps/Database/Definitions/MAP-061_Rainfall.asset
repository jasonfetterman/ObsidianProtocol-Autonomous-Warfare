%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0263df275083eba45b37ab9636c8dcbf, type: 3}
  m_Name: MAP-061_Rainfall
  m_EditorClassIdentifier:
  mapId: MAP-061
  displayName: Rainfall
  environment: Jungle / Tropical / Weather
  warfareFocus: Weather, Concealment, Sensor Degradation
  executiveSummary: >-
    Rainfall is a dense tropical jungle battlefield built for weather-driven combat,
    concealment, sensor degradation, and autonomous navigation through vegetation-heavy
    terrain. The environment features monsoon downpours, thick canopy cover, muddy
    trails, river gorges, waterfalls, cliffs, abandoned research huts, and overgrown
    ruins. The map emphasizes autonomous jungle-navigation logic, sensor-fusion under
    heavy rainfall, comms-relay warfare, and logistics under extreme humidity and
    visibility loss. In AR, the map anchors at approximately 4-5 m viewing distance,
    covering a 10x10 m physical area representing approximately 1 km2 of tropical
    jungle terrain.
  designGoals:
  - name: Weather-Driven Combat
    description: >-
      Rainfall prioritizes combat during heavy monsoon rain. Visibility drops, mud
      slows movement, and waterlogged terrain reshapes cover and traversal.
  - name: Concealment & Ambush Warfare
    description: >-
      Dense foliage, canopy shadows, and rain-driven fog create natural stealth zones.
      Ambushes, flanking, and sudden close-range engagements dominate.
  - name: Autonomy & Jungle Navigation
    description: >-
      Autonomous units choose routes based on vegetation density, mud stability,
      canopy cover, and sensor clarity. Units avoid flooded ravines unless strategically necessary.
  - name: Sensor & Information Warfare
    description: >-
      Rain, fog, humidity, thermal distortion, and vegetation clutter degrade sensors.
      Relay towers on cliffs restore clarity. Destroying relays creates blind pockets across the jungle.
  - name: Logistics & Resources
    description: >-
      Fuel caches, research huts, and river docks serve as resupply nodes. Convoys
      must navigate muddy trails and avoid ambush-prone canopy corridors.
  deployment: >-
    Fixed deployment budget of approximately 10,000 points. Blue deploys from the
    southwest river dock; Red deploys from the northeast cliffside command hut.
  ar:
    viewingDistance: 4-5 m
    physicalArea: 10x10 m
    representedArea: approximately 1 km2
    scale: 1:100
    fov: approximately 53 degrees diagonal
    resolution: 1920x1080 per eye
    tracking: Inside-out tracking detects horizontal planes.
    interaction: Depth mesh if available provides limited occlusion; assume minimal real-world occlusion.
  coordinateSystem: 1000x1000 grid, 1 unit approximately 1 m, origin (0,0) southwest corner
  keyLocations:
  - name: Blue HQ (River Dock Camp)
    coordinate: (0,0)
    sizeOrElevation: 150x150 m
    description: Boats, crates, jungle staging area.
  - name: Red HQ (Cliffside Command Hut)
    coordinate: (1000,1000)
    sizeOrElevation: 150x150 m
    description: Elevated bunker with radar mast and thermal relays.
  - name: Central Jungle Basin
    coordinate: (500,450)
    sizeOrElevation: 300x300 m
    description: Dense canopy, heavy rainfall, fog pockets, long-range sightlines broken by vegetation.
  - name: Research Hut Cluster
    coordinate: (250,800)
    sizeOrElevation: 120x120 m
    description: Abandoned labs, generators, interior flanking routes.
  - name: Canopy Ridge Network
    coordinate: (800,300)
    sizeOrElevation: 200x200 m
    description: High-ground overwatch, tree-top concealment, stealth movement.
  - name: Monsoon Corridor
    coordinate: (0,450 -> 400,900)
    sizeOrElevation: Severe rainfall zone
    description: Extreme sensor degradation.
  - name: Muddy Trail Route
    coordinate: (300,0 -> 450,350)
    sizeOrElevation: Safer but slow
    description: Mud hazards and vegetation cover.
  - name: Cliff Relay A
    coordinate: (650,150)
    sizeOrElevation: +240 m
    description: Long-range sensor vantage point.
  - name: Cliff Relay B
    coordinate: (150,650)
    sizeOrElevation: +260 m
    description: Comms relay hub and weather-monitoring node.
  - name: Neutral Forward Outpost
    coordinate: (500,950)
    sizeOrElevation: Drone resupply zone
    description: Neutral forward drone resupply area.
  chokepointsAndSightlines:
  - name: Monsoon Corridor
    description: Severe visibility loss; ideal for stealth ambushes and sensor deception.
  - name: Canopy Ridge Network
    description: Interior flanking routes; unpredictable cover due to foliage.
  - name: Jungle Basin
    description: Long-range engagements broken by vegetation; rain reduces accuracy.
  - name: Muddy Trail Route
    description: Predictable but safe; vulnerable to overwatch from ridges.
  - name: Cliff Relay A
    description: Long-range sensor coverage of approximately 300 m; rain and fog create fog-of-war pockets.
  terrain: Jungle canopy, cliffs, rivers, mud trails, research huts.
  vegetation: Dense trees, vines, ferns, underbrush.
  buildingsAndProps: >-
    Military: radar dishes, thermal relays, bunkers. Rural: huts, bridges,
    wooden structures. Logistics: trucks, crates, fuel drums, boats, drones.
  effects: Rainstorms, fog, humidity haze, mud splashes, canopy shadows.
  audio: Rainfall, insects, distant machinery, river flow, radio chatter.
  lodBudget:
  - category: Jungle Terrain
    count: 3
    trianglesPerItem: 200000
    totalTriangles: 600000
  - category: Rural/Industrial
    count: 4
    trianglesPerItem: 80000
    totalTriangles: 320000
  - category: Buildings/Rural
    count: 15
    trianglesPerItem: 50000
    totalTriangles: 750000
  - category: Roads/Paths
    count: 4
    trianglesPerItem: 30000
    totalTriangles: 120000
  - category: Props
    count: 50
    trianglesPerItem: 10000
    totalTriangles: 500000
  textureBudget: 2048² terrain/buildings, 1024² props, DXT1/5 compression, target <=100 MB.
  engineAndPlugins: Unreal ARTemplate + Nreal SDK (XREAL). ARKit/ARCore enabled.
  rendering: Forward renderer, stationary lights, baked GI, aggressive culling.
  anchors: Single spatial anchor for entire map.
  interaction: Phone pointer for pan/zoom; HUD as screen-space widgets.
  multiplayer: Client-server architecture; offload AI/physics to server.
  milestones:
  - name: Prototype Layout
    description: Month 1 - Block-out jungle basin, ridges, huts, AR anchor test.
  - name: Core Systems
    description: Month 2 - NavMesh, jungle autonomy behaviors, weather logic.
  - name: AR Integration
    description: Month 3 - Anchors, plane detection, basic interactivity.
  - name: Content Fill
    description: Month 4-5 - Final models, textures, lighting, audio.
  - name: Gameplay & Polish
    description: Month 6-7 - Objectives, balance, VFX including rain, fog, and mud.
  - name: Testing & QA
    description: Month 8 - Multiplayer stress test, sensor validation.
  testing:
  - name: Autonomy
    description: Verify jungle navigation, weather-aware pathfinding, hazard avoidance.
  - name: Comms/Sensors
    description: Test relay destruction, fog-of-war updates, LOS checks under monsoon conditions.
  - name: Performance
    description: Maintain at least 60 Hz AR render on target device.
  - name: QA Checklist
    description: Navigation, weather logic, deployment budget enforcement, anchor drift, sensor accuracy.
