        private void Back()
        {
            if (currentWindow != null)
            {
                CloseCurrentWindow();

                Debug.Log(
                    "[DEPLOYMENT] BACK // CURRENT WINDOW CLOSED");

                return;
            }

            GameObject hud =
                FindSceneObject("[HUD] DEPLOYMENT HUD");

            if (hud != null)
            {
                hud.SetActive(false);

                DeploymentTerminalInteraction terminal =
                    FindFirstObjectByType<DeploymentTerminalInteraction>();

                if (terminal != null)
                    terminal.CloseDeploymentHUD();

                Debug.Log(
                    "[DEPLOYMENT] BACK // DEPLOYMENT HUD CLOSED");
            }
        }

        private void TryOpenBattlefield()
        {
            string[] scenePaths =
            {
                "Assets/Scenes/SCN03_BATTLEFIELD_AAA/SCN03_BATTLEFIELD_AAA.unity",
                "SCN03_BATTLEFIELD_AAA",
                "Assets/Scenes/SCN03 _BATTLEFIELD/[HUD] BATTLEFIELD HUD/Battlefield_HUD.unity",
                "Battlefield_HUD"
            };

            foreach (string scenePath in scenePaths)
            {
                if (Application.CanStreamedLevelBeLoaded(scenePath))
                {
                    SceneManager.LoadScene(scenePath);
                    return;
                }

                if (Application.CanStreamedLevelBeLoaded(
                    System.IO.Path.GetFileNameWithoutExtension(
                        scenePath)))
                {
                    SceneManager.LoadScene(
                        System.IO.Path.GetFileNameWithoutExtension(
                            scenePath));
                    return;
                }
            }

            Debug.LogWarning(
                "[DEPLOYMENT] BATTLEFIELD SCENE NOT FOUND IN BUILD SETTINGS");
        }

        private void HideAllWindows()
        {
            foreach (string windowName in windows)
            {
                GameObject window =
                    FindSceneObject(windowName);

                if (window != null)
                    window.SetActive(false);
            }

            currentWindow = null;
        }

        private void OpenWindow(string windowName)
        {
            HideAllWindows();

            GameObject window =
                FindSceneObject(windowName);

            if (window == null)
            {
                Debug.LogWarning(
                    "[DEPLOYMENT] WINDOW NOT FOUND // " +
                    windowName);
                return;
            }

            window.SetActive(true);
            currentWindow = window;

            Debug.Log(
                "[DEPLOYMENT] OPENED // " +
                windowName);
        }

        private void CloseCurrentWindow()
        {
            if (currentWindow != null)
                currentWindow.SetActive(false);

            currentWindow = null;
        }

        private void BindButton(
            string objectName,
            UnityEngine.Events.UnityAction action)
        {
            GameObject obj =
                FindSceneObject(objectName);

            if (obj == null)
            {
                Debug.LogWarning(
                    "[DEPLOYMENT] BUTTON NOT FOUND // " +
                    objectName);
                return;
            }

            Button button =
                obj.GetComponent<Button>();

            if (button == null)
            {
                Debug.LogWarning(
                    "[DEPLOYMENT] NO BUTTON COMPONENT // " +
                    objectName);
                return;
            }

            button.onClick.AddListener(action);
        }

        private GameObject FindSceneObject(
            string objectName)
        {
            GameObject[] objects =
                UnityEngine.Resources
                    .FindObjectsOfTypeAll<GameObject>();

            GameObject best = null;
            int bestScore = int.MinValue;

            foreach (GameObject obj in objects)
            {
                if (obj.name != objectName)
                    continue;

                if (obj.hideFlags != HideFlags.None)
                    continue;

                int score = 0;

                RectTransform rect =
                    obj.GetComponent<RectTransform>();

                if (rect != null)
                {
                    if (rect.parent != null)
                        score += 100;

                    if (rect.childCount > 0)
                        score += 100;

                    if (rect.anchorMin !=
                        new Vector2(0.5f, 0.5f))
                        score += 50;

                    if (rect.anchorMax !=
                        new Vector2(0.5f, 0.5f))
                        score += 50;
                }

                if (score > bestScore)
                {
                    bestScore = score;
                    best = obj;
                }
            }

            return best;
        }

        private void UpdateDisplays()
        {
            int remaining = 0;
            int maximum = 0;

            if (deploymentMode == DeploymentMode.Offline &&
                deploymentBudget != null)
            {
                remaining = deploymentBudget.RemainingPoints;
                maximum = deploymentBudget.MaximumPoints;
            }
            else if (deploymentMode == DeploymentMode.Multiplayer &&
                     battleBudget != null)
            {
                remaining = battleBudget.RemainingBudget;
                maximum = battleBudget.StartingBudget;
            }

            string budgetDisplay =
                remaining.ToString("N0") +
                " / " +
                maximum.ToString("N0");

            SetText("[STAT] 10,000 / 10,000", budgetDisplay);

            SetText(
                "REMAINING BUDGET",
                remaining.ToString("N0") + " DP");

            SetText(
                "BUDGET SUMMARY",
                remaining.ToString("N0") + " DP REMAINING");
        }

        private void SetText(
            string objectName,
            string value)
        {
            GameObject obj =
                FindSceneObject(objectName);

            if (obj == null)
                return;

            TMP_Text tmp =
                obj.GetComponent<TMP_Text>();

            if (tmp != null)
            {
                tmp.text = value;
                return;
            }

            Text legacy =
                obj.GetComponent<Text>();

            if (legacy != null)
                legacy.text = value;
        }
