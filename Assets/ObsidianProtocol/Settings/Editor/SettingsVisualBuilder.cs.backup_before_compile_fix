    [MenuItem("Obsidian Protocol/Settings/BUILD AAA SETTINGS SCENE")]
    public static void BuildSettingsHUD()
    {
        string scenePath = FindSettingsScene();

        if (string.IsNullOrEmpty(scenePath))
        {
            EditorUtility.DisplayDialog("Settings", "Settings.unity was not found.", "OK");
            return;
        }

        DisplayFont = AssetDatabase.LoadAssetAtPath<TMP_FontAsset>(
            "Assets/TextMesh Pro/Resources/Fonts & Materials/EurostileExtendedBlack SDF.asset");

        BodyFont = AssetDatabase.LoadAssetAtPath<TMP_FontAsset>(
            "Assets/TextMesh Pro/Resources/Fonts & Materials/JetBrainsMono-VariableFont_wght SDF.asset");

        if (DisplayFont == null || BodyFont == null)
        {
            EditorUtility.DisplayDialog("Settings", "Required TextMesh Pro fonts could not be loaded.", "OK");
            return;
        }

        Scene scene = EditorSceneManager.OpenScene(scenePath, OpenSceneMode.Single);

        foreach (GameObject obj in scene.GetRootGameObjects())
        {
            if (obj.name == "EventSystem" || obj.GetComponent<Camera>() != null ||
                obj.GetComponent<Light>() != null)
                continue;

            if (obj.name == CanvasName || obj.name == RootName ||
                obj.GetComponent<Canvas>() != null ||
                obj.name.Contains("SETTINGS") || obj.name.Contains("[HUD]"))
                Object.DestroyImmediate(obj);
        }

        EnsureEventSystem();

        GameObject canvasObject = new GameObject(
            CanvasName, typeof(RectTransform), typeof(Canvas),
            typeof(CanvasScaler), typeof(GraphicRaycaster));

        Canvas canvas = canvasObject.GetComponent<Canvas>();
        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
        canvas.sortingOrder = 100;

        CanvasScaler scaler = canvasObject.GetComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1920, 1080);
        scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;
        scaler.matchWidthOrHeight = 0.5f;

        GameObject root = Panel(RootName, canvasObject.transform,
            Vector2.zero, Vector2.one, Background);

        BuildBackdrop(root.transform);
        BuildHeader(root.transform);
        BuildNavigation(root.transform);
        BuildPages(root.transform);
        BuildCustomization(root.transform);
        BuildFooter(root.transform);

        root.AddComponent<SettingsSceneController>();

        EditorSceneManager.MarkSceneDirty(scene);
        EditorSceneManager.SaveScene(scene);
        Selection.activeGameObject = root;

        Debug.Log("[SettingsVisualBuilder] New AAA Settings interface built: " + scenePath);

        EditorUtility.DisplayDialog(
            "AAA SETTINGS",
            "New Settings interface created and saved.\n\nOpen the scene to review the design.",
            "OK");
    }

    private static string FindSettingsScene()
    {
        foreach (string guid in AssetDatabase.FindAssets("t:Scene"))
        {
            string path = AssetDatabase.GUIDToAssetPath(guid);
            if (System.IO.Path.GetFileName(path).Equals(
                "Settings.unity", System.StringComparison.OrdinalIgnoreCase))
                return path;
        }
        return null;
    }

    private static void EnsureEventSystem()
    {
        if (Object.FindObjectOfType<EventSystem>() != null) return;

        GameObject es = new GameObject("EventSystem",
            typeof(EventSystem), typeof(StandaloneInputModule));
    }

