    private static TMP_FontAsset DisplayFont;
    private static TMP_FontAsset BodyFont;

    private static readonly Color Background = new Color(0.012f, 0.020f, 0.029f);
    private static readonly Color Surface = new Color(0.026f, 0.039f, 0.052f);
    private static readonly Color SurfaceRaised = new Color(0.039f, 0.058f, 0.073f);
