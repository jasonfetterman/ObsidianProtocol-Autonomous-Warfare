        Transform page = Panel(name, parent, Vector2.zero, Vector2.one,
            new Color(0, 0, 0, 0)).transform;

        Text(page, "PAGE_TITLE", title, 0.045f, 0.875f, 0.95f, 0.965f,
            29, White, true, TextAlignmentOptions.MidlineLeft);

        Text(page, "PAGE_SUBTITLE", subtitle, 0.047f, 0.825f, 0.95f, 0.875f,
            13, Muted, false, TextAlignmentOptions.MidlineLeft);

        Panel("TITLE_RULE", page, new Vector2(0.045f, 0.805f),
            new Vector2(0.955f, 0.809f), new Color(Cyan.r, Cyan.g, Cyan.b, 0.55f));

        Transform card = Panel("SETTINGS_CARD", page,
            new Vector2(0.045f, 0.07f), new Vector2(0.955f, 0.77f), SurfaceRaised).transform;

        Text(card, "CARD_LABEL", "SYSTEM OPTIONS", 0.035f, 0.91f,
            0.95f, 0.98f, 12, Cyan, false, TextAlignmentOptions.MidlineLeft);

        for (int i = 0; i < labels.Length; i++)
        {
            float y = 0.78f - i * 0.135f;
            SettingRow(card, "OPTION_" + i, labels[i], values[i], y);
        }

        return page;
    }

    private static void SettingRow(Transform parent, string name,
        string label, string value, float y)
    {
        Transform row = Panel(name, parent,
            new Vector2(0.025f, y - 0.105f), new Vector2(0.975f, y),
            Surface).transform;

        Text(row, "LABEL", label, 0.035f, 0.12f, 0.66f, 0.88f,
            14, White, false, TextAlignmentOptions.MidlineLeft);

        Text(row, "VALUE", value, 0.68f, 0.12f, 0.96f, 0.88f,
            13, Cyan, false, TextAlignmentOptions.MidlineRight);
    }

    private static void SliderRow(Transform parent, string name,
        string label, float y, float value)
    {
        Transform row = Panel(name, parent,
            new Vector2(0.025f, y - 0.105f), new Vector2(0.975f, y),
            Surface).transform;

        Text(row, "LABEL", label, 0.035f, 0.52f, 0.40f, 0.92f,
            14, White, false, TextAlignmentOptions.MidlineLeft);

        GameObject sliderObject = new GameObject("SLIDER",
            typeof(RectTransform), typeof(Slider));
        sliderObject.transform.SetParent(row, false);

        RectTransform rect = sliderObject.GetComponent<RectTransform>();
        rect.anchorMin = new Vector2(0.53f, 0.36f);
        rect.anchorMax = new Vector2(0.94f, 0.64f);
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;

        Image track = sliderObject.AddComponent<Image>();
        track.color = new Color(0.10f, 0.15f, 0.18f);

        GameObject fill = new GameObject("FILL", typeof(RectTransform), typeof(Image));
        fill.transform.SetParent(sliderObject.transform, false);
        RectTransform fillRect = fill.GetComponent<RectTransform>();
        fillRect.anchorMin = Vector2.zero;
        fillRect.anchorMax = Vector2.one;
        fillRect.offsetMin = Vector2.zero;
        fillRect.offsetMax = Vector2.zero;
        fill.GetComponent<Image>().color = Cyan;

        Slider slider = sliderObject.GetComponent<Slider>();
        slider.fillRect = fillRect;
        slider.targetGraphic = track;
        slider.minValue = 0;
        slider.maxValue = 1;
        slider.value = value;
        slider.direction = Slider.Direction.LeftToRight;
    }

