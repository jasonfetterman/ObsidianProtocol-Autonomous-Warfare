using UnityEngine;
using ObsidianProtocol.Game.Command;

public class IntentButton : MonoBehaviour
{
    [SerializeField] private ObsidianProtocol.Game.Command.IntentType intentType;
    [SerializeField] private CommandIntentManager intentManager;

    public void OnClick()
    {
        if (intentManager != null)
        {
            intentManager.IssueIntent(intentType);
        }
    }
}